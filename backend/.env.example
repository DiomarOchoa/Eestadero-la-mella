# Configuración del servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estadero_la_mella
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=cambia_esta_clave_por_una_muy_larga_y_secreta
JWT_EXPIRES_IN=8h

# CORS - URL del frontend
FRONTEND_URL=http://localhost:5173

# Pool PostgreSQL (escalabilidad multi-negocio)
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_CONN_TIMEOUT_MS=10000

# Cobro SaaS: secreto interno del webhook (Wompi/ePayco lo reenvían con este header)
BILLING_WEBHOOK_SECRET=cambia_este_secreto_largo

# Instalación inicial sin Shell (Render free): secreto de UN SOLO USO para crear
# el primer superadmin vía POST /api/admin/bootstrap. Bórralo tras usarlo.
ADMIN_SETUP_SECRET=cambia_este_otro_secreto_largo
